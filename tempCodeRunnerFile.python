# define in function of Hello

def hello(name = "Student"):
    print("Hello ",name)

hello("Ravi")
hello()

# questions :- write functions to print all the element this of a given list l = [10,20,30,40,50]
li = [10,20,30,40,50]

def pl(l):
    for i in range(len(l)):
        print(l[i], end = " ")
    print()

pl(li)

